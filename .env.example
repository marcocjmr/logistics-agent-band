# -----------------------------------------------------------------------------
# Configuración de API Keys para Band of Agents Hackathon
# Copia este archivo como .env y rellena con tus claves reales.
# -----------------------------------------------------------------------------

# --- BAND.AI (Orquestador de Agentes) ---
# Clave de API de Band.ai / Thenvoi para conectar tus agentes externos.
BAND_API_KEY=tu_band_api_key_aqui

# ID o UUID del agente principal registrado en la plataforma Band.ai.
BAND_AGENT_ID=tu_band_agent_id_aqui

# ID de la Sala activa de Band.ai donde colaboran los agentes.
BAND_ROOM_ID=tu_band_room_id_aqui

# --- CONFIGURACIÓN DE AGENTES (IDs y Handles en la sala de Band) ---
REQUIREMENTS_ANALYST_ID=id_del_analista_ingesta
REQUIREMENTS_ANALYST_HANDLE=analyst_handle

TRANSIT_PLANNER_ID=id_del_planificador_transito
TRANSIT_PLANNER_HANDLE=transit_handle

ACCOMMODATION_SCOUT_ID=id_del_explorador_alojamiento
ACCOMMODATION_SCOUT_HANDLE=lodging_handle

FINANCIAL_AUDITOR_ID=id_del_auditor_financiero
FINANCIAL_AUDITOR_HANDLE=auditor_handle

# --- PARTNER 1: AI/ML API ---
# Clave para acceder a modelos de inferencia avanzada y razonamiento.
AIML_API_KEY=tu_aiml_api_key_aqui

# --- PARTNER 2: FEATHERLESS AI ---
# Clave para acceder a modelos open-source rápidos y ligeros.
FEATHERLESS_API_KEY=tu_featherless_api_key_aqui

--Null--
--NULL--
